{
  "name": "arkiv-claude-plugin",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "check": "node scripts/build-plugin.mjs --check && node scripts/check-static.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "validate": "claude plugin validate --strict . && claude plugin validate --strict plugins/arkiv"
  }
}
