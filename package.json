{
  "name": "arkiv-claude-plugin",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "check": "node scripts/build-plugin.mjs --check && node scripts/check-static.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "validate": "node scripts/release-gate.mjs validate",
    "release:check": "node scripts/release-gate.mjs check",
    "tag": "node scripts/release-gate.mjs tag",
    "prepack": "node scripts/release-gate.mjs check",
    "prepublishOnly": "node scripts/release-gate.mjs check"
  }
}
