      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "maxLength": 160 },
          "historical": { "type": "boolean", "default": false },
          "offset": { "type": "integer", "minimum": 0, "maximum": 180000, "default": 0 },
          "topic": { "type": "string", "enum": ["entities", "queries", "expiration", "network", "packages", "skills", "workflow", "bounty", "other"] }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  ]
