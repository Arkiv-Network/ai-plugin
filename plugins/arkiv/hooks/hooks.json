{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/arkiv-rules.mjs"
            ],
            "timeout": 2,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
